
# Hostname for the CRM site
CRM_SITE_HOST=localhost

# Port mappings
CRM_HTTP_PORT=80
CRM_HTTPS_PORT=443
      
# Initial admin credentials - change these after first login
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=password

# Local backup folder
LOCAL_BACKUP_FOLDER=./local_backups

# Restore configuration
#RESTORE_POINT=./local_backups/backup-2025-10-15T12-00-00.tar.gz

# Database configuration
DB_ROOT_PASSWORD=root_password
DB_DATABASE=espocrm
DB_USER=espocrm
DB_PASSWORD=database_password